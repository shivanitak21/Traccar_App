{
  "expo": {
    "name": "Elevatics Fleet",
    "slug": "fleet-tracker",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/elevactics_logo.png",
    "scheme": "fleet-tracker",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0d0f14",
    "splash": {
      "backgroundColor": "#0d0f14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.elevatics.fleet",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Fleet Tracker needs your location to display it on the map.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Fleet Tracker uses your location for live tracking."
      }
    },
    "android": {
      "package": "com.elevatics.fleet",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/elevactics_logo.png",
        "backgroundColor": "#0d0f14"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/elevactics_logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Elevatics Fleet to use your location for live tracking."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "traccarBaseUrl": "https://elevaticsiot.com",
      "mapboxPublicToken": "pk.eyJ1IjoidmluZWV0MDE5IiwiYSI6ImNtYzIyNG9rOTAzbnYyanE1a2dweGZ3azQifQ.NQ6QssrC2iQzgb-tLdMLDw"
    }
  }
}
